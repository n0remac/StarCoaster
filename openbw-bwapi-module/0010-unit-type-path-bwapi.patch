+bool Game::hasUnitTypePath(int type, int fromX, int fromY, int toX, int toY)
+{
+  if (type < 0 || type >= 228 || fromX < 0 || fromY < 0 || toX < 0 || toY < 0
+      || fromX >= int(impl->funcs.game_st.map_tile_width * 32)
+      || toX >= int(impl->funcs.game_st.map_tile_width * 32)
+      || fromY >= int(impl->funcs.game_st.map_tile_height * 32)
+      || toY >= int(impl->funcs.game_st.map_tile_height * 32)) return false;
+  return impl->funcs.has_unit_type_path(static_cast<bwgame::UnitTypes>(type),
+      {fromX, fromY}, {toX, toY});
+}
