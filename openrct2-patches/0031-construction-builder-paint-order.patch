+// Construction plates use the large-scenery paint bounds (45 units above the
+// ground). A native builder standing at the site otherwise sorts behind those
+// tiles. Only the sorting box is lifted; the image, map position, and hit test
+// keep the actor's actual world coordinates.
+static int32_t BridgeConstructionBuilderSortZ(const CoordsXY& actorPos, int32_t actorZ)
+{
+    const auto animations = std::atomic_load(&gBridgeBuildingAnimations);
+    if (animations->session != std::atomic_load(&gBridgeSnapshot)->session)
+        return actorZ + 5;
+    const auto origin = actorPos.toTileStart();
+    int32_t sortZ = actorZ + 5;
+    for (const auto& [objectIndex, state] : animations->objects)
+    {
+        // Search the builder's tile and immediate neighbours. A native SCV
+        // can work from the edge just outside its building's footprint.
+        for (int32_t dy = -32; dy <= 32; dy += 32)
+            for (int32_t dx = -32; dx <= 32; dx += 32)
+            {
+                const CoordsXY tile{ origin.x + dx, origin.y + dy };
+                const auto frame = state.tiles.find({ tile.x, tile.y });
+                if (frame == state.tiles.end() || frame->second <= state.frames || !MapIsLocationValid(tile))
+                    continue; // Training lights and completed buildings are unrelated.
+                const int32_t tileZ = TileElementHeight(tile);
+                if (std::abs(tileZ - actorZ) <= 8)
+                    sortZ = std::max(sortZ, tileZ + 48);
+            }
+    }
+    return sortZ;
+}
