+
+void PaintBridgeActors(PaintSession& session, const CoordsXY& pos)
+{
+    auto snapshot = std::atomic_load(&gBridgeSnapshot);
+    const auto bucket = snapshot->tiles.find({ pos.x / 32, pos.y / 32 });
+    if (bucket == snapshot->tiles.end())
+        return;
+    if (gTrackDesignSaveMode || session.ViewFlags.has(ViewportFlag::hideEntities) || session.rt.zoom_level > ZoomLevel{ 2 })
+        return;
+    for (const size_t index : bucket->second)
+    {
+        const auto& actor = snapshot->actors[index];
+        const auto& visual = snapshot->visual.at(actor.id);
+        const auto actorPos = VisualPosition(actor, visual);
+        if (pos != actorPos.toTileStart() || !MapIsLocationValid(actorPos))
+            continue;
+        session.SpritePosition = actorPos;
+        session.MapPosition = pos;
+        session.CurrentlyDrawnEntity = nullptr;
+        session.CurrentlyDrawnTileElement = nullptr;
+        session.InteractionType = ViewportInteractionItem::none;
+        int32_t z = TileElementHeight(actorPos);
+        // Paths have their own surface. Use it for feet when it sits above the
+        // terrain, while keeping the draw position distinct from paint sorting.
+        for (auto* path : TileElementsView<PathElement>(actorPos))
+            if (!path->isGhost() && path->getBaseZ() >= z)
+                z = path->getBaseZ();
+        // BWAPI headings are in map coordinates. Project that heading through
+        // the same isometric transform as the actor's feet before selecting a
+        // screen-facing GRP frame. A world-west shot, for example, points
+        // northeast on the unrotated park viewport.
+        const double heading = static_cast<double>(actor.facing) * (2.0 * 3.14159265358979323846 / 256.0);
+        const double worldDx = std::cos(heading);
+        const double worldDy = std::sin(heading);
+        double rotatedDx = worldDx;
+        double rotatedDy = worldDy;
+        switch (session.CurrentRotation & 3)
+        {
+            case 1: rotatedDx = worldDy; rotatedDy = -worldDx; break;
+            case 2: rotatedDx = -worldDx; rotatedDy = -worldDy; break;
+            case 3: rotatedDx = -worldDy; rotatedDy = worldDx; break;
+        }
+        const double screenDx = rotatedDy - rotatedDx;
+        const double screenDy = (rotatedDx + rotatedDy) / 2.0;
+        const uint32_t direction = static_cast<uint32_t>(
+            std::lround(std::atan2(screenDy, screenDx) * (4.0 / 3.14159265358979323846)) + 8) & 7;
+        const bool diagonal = (direction & 1) != 0;
+        static_assert(SPR_BRIDGE_MARINE_IDLE0_EAST - SPR_BRIDGE_SCOUT_IDLE_EAST == 88,
+            "scout sprite registry count differs from g2 range");
+        static_assert(SPR_BRIDGE_SCOUT_DEATH0_EAST - SPR_BRIDGE_MARINE_IDLE0_EAST == 56,
+            "marine sprite registry count differs from g2 range");
+        static_assert(SPR_BRIDGE_HEALTH_MARINE_0 - SPR_BRIDGE_SCOUT_DEATH0_EAST == 48,
+            "scout death sprite registry count differs from g2 range");
+        static_assert(SPR_G2_END - SPR_BRIDGE_HEALTH_MARINE_0 == 22,
+            "health sprite registry count differs from g2 range");
+        constexpr uint32_t walkCardinal[] = { SPR_BRIDGE_SCOUT_WALK0_EAST, SPR_BRIDGE_SCOUT_WALK1_EAST,
+            SPR_BRIDGE_SCOUT_WALK2_EAST, SPR_BRIDGE_SCOUT_WALK3_EAST, SPR_BRIDGE_SCOUT_WALK4_EAST,
+            SPR_BRIDGE_SCOUT_WALK5_EAST, SPR_BRIDGE_SCOUT_WALK6_EAST, SPR_BRIDGE_SCOUT_WALK7_EAST,
+            SPR_BRIDGE_SCOUT_WALK8_EAST, SPR_BRIDGE_SCOUT_WALK9_EAST };
+        constexpr uint32_t walkDiagonal[] = { SPR_BRIDGE_SCOUT_WALK0_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK1_SOUTHEAST,
+            SPR_BRIDGE_SCOUT_WALK2_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK3_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK4_SOUTHEAST,
+            SPR_BRIDGE_SCOUT_WALK5_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK6_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK7_SOUTHEAST,
+            SPR_BRIDGE_SCOUT_WALK8_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK9_SOUTHEAST };
+        const uint32_t elapsed = getGameState().currentTicks - visual.animationStartTick;
+        uint32_t imageId = 0;
+        if (actor.kind == "terran_marine")
+        {
+            constexpr uint32_t marineBases[] = { SPR_BRIDGE_MARINE_IDLE0_EAST,
+                SPR_BRIDGE_MARINE_WALK0_EAST, SPR_BRIDGE_MARINE_WALK1_EAST,
+                SPR_BRIDGE_MARINE_ATTACK0_EAST, SPR_BRIDGE_MARINE_ATTACK1_EAST,
+                SPR_BRIDGE_MARINE_ATTACK2_EAST };
+            if (actor.motion == "death")
+                imageId = SPR_BRIDGE_MARINE_DEATH0 + std::min(7u, elapsed / 2);
+            else
+            {
+                uint32_t pose = 0;
+                if (actor.motion == "walk") pose = 1 + (elapsed / 4) % 2;
+                if (actor.motion == "attack") pose = 3 + (elapsed / 2) % 3;
+                imageId = marineBases[pose] + direction;
+            }
+        }
+        else
+        {
+            if (actor.motion == "death")
+                imageId = SPR_BRIDGE_SCOUT_DEATH0_EAST + std::min(5u, elapsed / 2) * 8 + direction;
+            else
+            {
+                const uint32_t frame = elapsed / 4 % 10;
+                const uint32_t imageBase = actor.motion != "walk"
+                    ? (diagonal ? SPR_BRIDGE_SCOUT_IDLE_SOUTHEAST : SPR_BRIDGE_SCOUT_IDLE_EAST)
+                    : (diagonal ? walkDiagonal[frame] : walkCardinal[frame]);
+                imageId = imageBase + direction / 2;
+            }
+        }
+        const BoundBoxXYZ actorBounds{ { -6, -6, z + 5 }, { 12, 12, 18 } };
+        PaintAddImageAsParent(session, ImageId(imageId), { 0, 0, z }, actorBounds);
+        if (actor.hp > 0 && actor.maxHp > 0 && actor.motion != "death")
+        {
+            const auto level = std::clamp((actor.hp * 10 + actor.maxHp / 2) / actor.maxHp, 0, 10);
+            const auto healthBase = actor.kind == "terran_marine" ? SPR_BRIDGE_HEALTH_MARINE_0 : SPR_BRIDGE_HEALTH_ZERGLING_0;
+            PaintAddImageAsChild(session, ImageId(healthBase + level), { 0, 0, z }, actorBounds);
+        }
+    }
+}
