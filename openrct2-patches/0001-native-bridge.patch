 using namespace OpenRCT2;
 using namespace OpenRCT2::Drawing;
 
+namespace
+{
+    struct BridgeSnapshot
+    {
+        std::string session;
+        uint64_t seq = 0;
+        std::vector<BridgeActor> actors;
+        struct VisualState
+        {
+            uint32_t animationStartTick = 0;
+            int32_t previousX = 0;
+            int32_t previousY = 0;
+            uint32_t blendStartTick = 0;
+            uint32_t blendDuration = 1;
+        };
+        std::map<std::string, VisualState> visual;
+        std::map<std::pair<int32_t, int32_t>, std::vector<size_t>> tiles;
+    };
+
+    std::shared_ptr<const BridgeSnapshot> gBridgeSnapshot = std::make_shared<BridgeSnapshot>();
+
+    uint32_t BridgePhase(const std::string& id)
+    {
+        uint32_t hash = 2166136261u;
+        for (unsigned char character : id)
+            hash = (hash ^ character) * 16777619u;
+        return (hash % 10) * 4;
+    }
+
+    void InvalidateBridgeActor(const BridgeActor& actor)
+    {
+        const CoordsXY position{ actor.x, actor.y };
+        if (!MapIsLocationValid(position))
+            return;
+        // The image can extend well above the feet and across neighbouring
+        // tiles. Invalidate both the old and new full screen footprints.
+        ViewportsInvalidate({ actor.x, actor.y, TileElementHeight(position) }, 80, 80, 48, ZoomLevel{ 2 });
+    }
+
+    CoordsXY VisualPosition(const BridgeActor& actor, const BridgeSnapshot::VisualState& state)
+    {
+        const uint32_t elapsed = getGameState().currentTicks - state.blendStartTick;
+        const uint32_t t = std::min(elapsed, state.blendDuration);
+        return { state.previousX + static_cast<int32_t>((actor.x - state.previousX) * static_cast<int64_t>(t) / state.blendDuration),
+            state.previousY + static_cast<int32_t>((actor.y - state.previousY) * static_cast<int64_t>(t) / state.blendDuration) };
+    }
+
+    void AddTile(BridgeSnapshot& snapshot, size_t index, int32_t x, int32_t y)
+    {
+        auto& bucket = snapshot.tiles[{ x / 32, y / 32 }];
+        if (std::find(bucket.begin(), bucket.end(), index) == bucket.end())
+            bucket.push_back(index);
+    }
+} // namespace
+
+void BridgeApplySnapshot(std::string session, uint64_t seq, std::vector<BridgeActor> actors)
+{
+    auto previous = std::atomic_load(&gBridgeSnapshot);
+    if (previous->session == session && seq <= previous->seq)
+        return;
+
+    auto next = std::make_shared<BridgeSnapshot>();
+    next->session = std::move(session);
+    next->seq = seq;
+    next->actors = std::move(actors);
+    std::sort(next->actors.begin(), next->actors.end(), [](const auto& a, const auto& b) { return a.id < b.id; });
+    std::map<std::string, BridgeActor> oldActors;
+    if (previous->session == next->session)
+        for (const auto& actor : previous->actors)
+            oldActors.emplace(actor.id, actor);
+    const auto tick = getGameState().currentTicks;
+    for (size_t index = 0; index < next->actors.size(); ++index)
+    {
+        const auto& actor = next->actors[index];
+        BridgeSnapshot::VisualState visual{};
+        visual.previousX = actor.x;
+        visual.previousY = actor.y;
+        visual.animationStartTick = tick - BridgePhase(actor.id);
+        visual.blendStartTick = tick;
+        const auto old = oldActors.find(actor.id);
+        if (old != oldActors.end())
+        {
+            const auto previousVisual = previous->visual.find(actor.id);
+            if (previousVisual != previous->visual.end())
+            {
+                if (actor.motion == old->second.motion && actor.attackFrames == old->second.attackFrames)
+                    visual.animationStartTick = previousVisual->second.animationStartTick;
+                const auto source = VisualPosition(old->second, previousVisual->second);
+                const int64_t dx = static_cast<int64_t>(actor.x) - old->second.x;
+                const int64_t dy = static_cast<int64_t>(actor.y) - old->second.y;
+                if (dx * dx + dy * dy <= 64 * 64 && tick - previousVisual->second.blendStartTick <= 16)
+                {
+                    visual.previousX = source.x;
+                    visual.previousY = source.y;
+                    visual.blendDuration = std::max(1u, std::min(8u, tick - previousVisual->second.blendStartTick));
+                }
+            }
+        }
+        next->visual.emplace(actor.id, visual);
+        for (int32_t tileX = std::min(actor.x, visual.previousX) / 32; tileX <= std::max(actor.x, visual.previousX) / 32; ++tileX)
+            for (int32_t tileY = std::min(actor.y, visual.previousY) / 32; tileY <= std::max(actor.y, visual.previousY) / 32; ++tileY)
+                AddTile(*next, index, tileX * 32, tileY * 32);
+    }
+    for (const auto& actor : previous->actors)
+    {
+        InvalidateBridgeActor(actor);
+        auto visual = previous->visual.find(actor.id);
+        if (visual != previous->visual.end())
+        {
+            BridgeActor displayed = actor;
+            const auto position = VisualPosition(actor, visual->second);
+            displayed.x = position.x;
+            displayed.y = position.y;
+            InvalidateBridgeActor(displayed);
+        }
+    }
+    std::atomic_store(&gBridgeSnapshot, std::shared_ptr<const BridgeSnapshot>(next));
+    std::ostringstream canonical;
+    for (const auto& actor : next->actors)
+    {
+        InvalidateBridgeActor(actor);
+        if (canonical.tellp() > 0) canonical << ';';
+        canonical << actor.id << ',' << actor.x << ',' << actor.y << ',' << static_cast<int>(actor.facing)
+                  << ',' << actor.motion << ',' << TileElementHeight({ actor.x, actor.y })
+                  << ',' << actor.kind << ',' << actor.hp << ',' << actor.maxHp << ',' << actor.owner
+                  << ',' << actor.attackFrames;
+    }
+    LOG_INFO("RTS Bridge apply tick=%u seq=%llu session=%s center_z=%d units=%s", tick,
+        static_cast<unsigned long long>(seq), next->session.c_str(), TileElementHeight({ 480, 480 }), canonical.str().c_str());
+}
+
+void BridgeInvalidateAnimation()
+{
+    auto snapshot = std::atomic_load(&gBridgeSnapshot);
+    for (const auto& actor : snapshot->actors)
+    {
+        auto it = snapshot->visual.find(actor.id);
+        if (it != snapshot->visual.end())
+        {
+            if (actor.motion == "idle" && getGameState().currentTicks - it->second.blendStartTick >= it->second.blendDuration)
+                continue;
+            BridgeActor old = actor;
+            const auto position = VisualPosition(actor, it->second);
+            old.x = position.x;
+            old.y = position.y;
+            InvalidateBridgeActor(old);
+        }
+        InvalidateBridgeActor(actor);
+    }
+}
+
+std::string BridgeHitTest(int32_t x, int32_t y, int32_t radius)
+{
+    if (radius < 0 || radius > 64) return {};
+    const auto snapshot = std::atomic_load(&gBridgeSnapshot);
+    std::string closest;
+    int64_t best = static_cast<int64_t>(radius) * radius + 1;
+    for (const auto& actor : snapshot->actors)
+    {
+        if (actor.motion == "death") continue;
+        const auto visual = snapshot->visual.find(actor.id);
+        if (visual == snapshot->visual.end()) continue;
+        const auto pos = VisualPosition(actor, visual->second);
+        const int64_t dx = static_cast<int64_t>(pos.x) - x;
+        const int64_t dy = static_cast<int64_t>(pos.y) - y;
+        const int64_t distance = dx * dx + dy * dy;
+        if (distance < best) { best = distance; closest = actor.id; }
+    }
+    return closest;
+}
+
+std::pair<std::string, std::vector<BridgeActor>> BridgeGetActors()
+{
+    const auto snapshot = std::atomic_load(&gBridgeSnapshot);
+    return { snapshot->session, snapshot->actors };
+}
