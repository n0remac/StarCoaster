+void PaintBridgeActors(PaintSession& session, const CoordsXY& pos)
+{
+    auto snapshot = std::atomic_load(&gBridgeSnapshot);
+    const auto bucket = snapshot->tiles.find({ pos.x / 32, pos.y / 32 });
+    if (bucket == snapshot->tiles.end())
+        return;
+    if (gTrackDesignSaveMode || session.ViewFlags.has(ViewportFlag::hideEntities) || session.rt.zoom_level > ZoomLevel{ 2 })
+        return;
+    for (const size_t index : bucket->second)
+    {
+        const auto& actor = snapshot->actors[index];
+        const auto& visual = snapshot->visual.at(actor.id);
+        const auto actorPos = VisualPosition(actor, visual);
+        if (pos != actorPos.toTileStart() || !MapIsLocationValid(actorPos))
+            continue;
+        session.SpritePosition = actorPos;
+        session.MapPosition = pos;
+        session.CurrentlyDrawnEntity = nullptr;
+        session.CurrentlyDrawnTileElement = nullptr;
+        session.InteractionType = ViewportInteractionItem::none;
+        const int32_t z = TileElementHeight(actorPos);
+        const uint32_t direction = ((actor.facing + 16) / 32 + session.CurrentRotation * 2) & 7;
+        const bool diagonal = (direction & 1) != 0;
+        static_assert(SPR_G2_END - SPR_BRIDGE_SCOUT_IDLE_EAST == 88, "bridge sprite registry count differs from g2 range");
+        constexpr uint32_t walkCardinal[] = { SPR_BRIDGE_SCOUT_WALK0_EAST, SPR_BRIDGE_SCOUT_WALK1_EAST,
+            SPR_BRIDGE_SCOUT_WALK2_EAST, SPR_BRIDGE_SCOUT_WALK3_EAST, SPR_BRIDGE_SCOUT_WALK4_EAST,
+            SPR_BRIDGE_SCOUT_WALK5_EAST, SPR_BRIDGE_SCOUT_WALK6_EAST, SPR_BRIDGE_SCOUT_WALK7_EAST,
+            SPR_BRIDGE_SCOUT_WALK8_EAST, SPR_BRIDGE_SCOUT_WALK9_EAST };
+        constexpr uint32_t walkDiagonal[] = { SPR_BRIDGE_SCOUT_WALK0_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK1_SOUTHEAST,
+            SPR_BRIDGE_SCOUT_WALK2_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK3_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK4_SOUTHEAST,
+            SPR_BRIDGE_SCOUT_WALK5_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK6_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK7_SOUTHEAST,
+            SPR_BRIDGE_SCOUT_WALK8_SOUTHEAST, SPR_BRIDGE_SCOUT_WALK9_SOUTHEAST };
+        const uint32_t frame = (getGameState().currentTicks - visual.animationStartTick) / 4 % 10;
+        const uint32_t imageBase = !actor.moving
+            ? (diagonal ? SPR_BRIDGE_SCOUT_IDLE_SOUTHEAST : SPR_BRIDGE_SCOUT_IDLE_EAST)
+            : (diagonal ? walkDiagonal[frame] : walkCardinal[frame]);
+        const uint32_t imageId = imageBase + direction / 2;
+        PaintAddImageAsParent(session, ImageId(imageId), { 0, 0, z }, { { -8, -8, z }, { 16, 16, 24 } });
+    }
+}
