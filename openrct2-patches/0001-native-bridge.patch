+
+static JSValue BridgeHitTestJS(JSContext* ctx, JSValueConst, int argc, JSValueConst* argv)
+{
+    int32_t x = 0, y = 0, radius = 20;
+    if (argc != 3 || JS_ToInt32(ctx, &x, argv[0]) != 0 || JS_ToInt32(ctx, &y, argv[1]) != 0
+        || JS_ToInt32(ctx, &radius, argv[2]) != 0 || radius < 0 || radius > 64)
+        return JS_ThrowTypeError(ctx, "expected world x, y and radius <= 64");
+    const auto id = BridgeHitTest(x, y, radius);
+    return id.empty() ? JS_NULL : JS_NewString(ctx, id.c_str());
+}
+
+static JSValue BridgeCursorWorldJS(JSContext* ctx, JSValueConst, int, JSValueConst*)
+{
+    const auto info = GetMapCoordinatesFromPos(ContextGetCursorPositionScaled(), ViewportInteractionItem::terrain);
+    if (info.interactionType == ViewportInteractionItem::none || !MapIsLocationValid(info.Loc)) return JS_NULL;
+    JSValue point = JS_NewObject(ctx);
+    JS_SetPropertyStr(ctx, point, "x", JS_NewInt32(ctx, info.Loc.x));
+    JS_SetPropertyStr(ctx, point, "y", JS_NewInt32(ctx, info.Loc.y));
+    return point;
+}
+
+static JSValue BridgeGetActorsJS(JSContext* ctx, JSValueConst, int, JSValueConst*)
+{
+    const auto [session, actors] = BridgeGetActors();
+    JSValue result = JS_NewObject(ctx);
+    JS_SetPropertyStr(ctx, result, "session", JS_NewString(ctx, session.c_str()));
+    JSValue units = JS_NewArray(ctx);
+    for (uint32_t index = 0; index < actors.size(); ++index)
+    {
+        const auto& actor = actors[index];
+        JSValue unit = JS_NewObject(ctx);
+        JS_SetPropertyStr(ctx, unit, "id", JS_NewString(ctx, actor.id.c_str()));
+        JS_SetPropertyStr(ctx, unit, "kind", JS_NewString(ctx, actor.kind.c_str()));
+        JS_SetPropertyStr(ctx, unit, "x", JS_NewInt32(ctx, actor.x));
+        JS_SetPropertyStr(ctx, unit, "y", JS_NewInt32(ctx, actor.y));
+        JS_SetPropertyStr(ctx, unit, "hp", JS_NewInt32(ctx, actor.hp));
+        JS_SetPropertyUint32(ctx, units, index, unit);
+    }
+    JS_SetPropertyStr(ctx, result, "units", units);
+    return result;
+}
