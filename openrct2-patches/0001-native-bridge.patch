 using namespace OpenRCT2;
 using namespace OpenRCT2::Drawing;
 
+namespace
+{
+    struct BridgeSnapshot
+    {
+        std::string session;
+        uint64_t seq = 0;
+        std::optional<BridgeActor> actor;
+    };
+
+    std::shared_ptr<const BridgeSnapshot> gBridgeSnapshot = std::make_shared<BridgeSnapshot>();
+
+    void InvalidateBridgeActor(const BridgeActor& actor)
+    {
+        const CoordsXY position{ actor.x, actor.y };
+        if (!MapIsLocationValid(position))
+            return;
+        auto* surface = MapGetSurfaceElementAt(position);
+        if (surface != nullptr)
+        {
+            ViewportsInvalidate({ actor.x, actor.y, surface->getBaseZ() }, 16, 28, 8, ZoomLevel{ 2 });
+        }
+    }
+} // namespace
+
+void BridgeApplySnapshot(std::string session, uint64_t seq, std::optional<BridgeActor> actor)
+{
+    auto previous = std::atomic_load(&gBridgeSnapshot);
+    if (previous->session == session && seq <= previous->seq)
+        return;
+
+    auto next = std::make_shared<BridgeSnapshot>();
+    next->session = std::move(session);
+    next->seq = seq;
+    next->actor = std::move(actor);
+    if (previous->actor)
+        InvalidateBridgeActor(*previous->actor);
+    std::atomic_store(&gBridgeSnapshot, std::shared_ptr<const BridgeSnapshot>(next));
+    if (next->actor)
+    {
+        InvalidateBridgeActor(*next->actor);
+        LOG_INFO("RTS Bridge apply tick=%u seq=%llu id=%s x=%d y=%d", getGameState().currentTicks,
+            static_cast<unsigned long long>(seq), next->actor->id.c_str(), next->actor->x, next->actor->y);
+    }
+    else
+    {
+        LOG_INFO("RTS Bridge apply tick=%u seq=%llu despawn", getGameState().currentTicks,
+            static_cast<unsigned long long>(seq));
+    }
+}
