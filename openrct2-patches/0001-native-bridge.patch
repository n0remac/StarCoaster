+static bool BridgeReadString(JSContext* ctx, JSValueConst object, const char* name, std::string& output)
+{
+    JSValue value = JS_GetPropertyStr(ctx, object, name);
+    if (!JS_IsString(value))
+    {
+        JS_FreeValue(ctx, value);
+        return false;
+    }
+    const char* text = JS_ToCString(ctx, value);
+    if (text != nullptr)
+    {
+        output = text;
+        JS_FreeCString(ctx, text);
+    }
+    JS_FreeValue(ctx, value);
+    return text != nullptr;
+}
+
+static bool BridgeReadInt(JSContext* ctx, JSValueConst object, const char* name, int32_t& output)
+{
+    JSValue value = JS_GetPropertyStr(ctx, object, name);
+    double number = 0;
+    const bool ok = JS_IsNumber(value) && JS_ToFloat64(ctx, &number, value) == 0 && std::isfinite(number)
+        && number == std::floor(number) && number >= INT32_MIN && number <= INT32_MAX
+        && JS_ToInt32(ctx, &output, value) == 0;
+    JS_FreeValue(ctx, value);
+    return ok;
+}
+
+static JSValue BridgeApplySnapshotJS(JSContext* ctx, JSValueConst, int argc, JSValueConst* argv)
+{
+    if (argc != 1 || !JS_IsObject(argv[0]))
+        return JS_ThrowTypeError(ctx, "expected one snapshot object");
+
+    std::string session;
+    int32_t seq = 0;
+    if (!BridgeReadString(ctx, argv[0], "session", session) || session.empty() || session.size() > 64
+        || !BridgeReadInt(ctx, argv[0], "seq", seq) || seq <= 0)
+        return JS_ThrowTypeError(ctx, "invalid bridge session or sequence");
+
+    JSValue units = JS_GetPropertyStr(ctx, argv[0], "units");
+    JSValue lengthValue = JS_GetPropertyStr(ctx, units, "length");
+    int32_t length = -1;
+    const bool validLength = JS_IsArray(units) && JS_ToInt32(ctx, &length, lengthValue) == 0 && length >= 0
+        && length <= 32;
+    JS_FreeValue(ctx, lengthValue);
+    if (!validLength)
+    {
+        JS_FreeValue(ctx, units);
+        return JS_ThrowTypeError(ctx, "bridge snapshot must contain at most 32 units");
+    }
+
+    std::vector<BridgeActor> actors;
+    std::set<std::string> ids;
+    const auto mapSize = GetMapSizeUnits();
+    for (int32_t index = 0; index < length; ++index)
+    {
+        JSValue unit = JS_GetPropertyUint32(ctx, units, index);
+        BridgeActor parsed{};
+        std::string motion;
+        int32_t facing = 0;
+        const bool valid = JS_IsObject(unit) && BridgeReadString(ctx, unit, "id", parsed.id)
+            && parsed.id.size() > 7 && parsed.id.size() <= 32 && parsed.id.compare(0, 7, "openbw:") == 0
+            && parsed.id.find_first_not_of("0123456789", 7) == std::string::npos && ids.insert(parsed.id).second
+            && BridgeReadInt(ctx, unit, "x", parsed.x) && BridgeReadInt(ctx, unit, "y", parsed.y)
+            && parsed.x >= 0 && parsed.y >= 0 && parsed.x < mapSize.x && parsed.y < mapSize.y
+            && BridgeReadInt(ctx, unit, "facing", facing) && facing >= 0 && facing <= 255
+            && BridgeReadString(ctx, unit, "motion", motion) && (motion == "idle" || motion == "walk");
+        JS_FreeValue(ctx, unit);
+        if (!valid)
+        {
+            JS_FreeValue(ctx, units);
+            return JS_ThrowTypeError(ctx, "invalid bridge unit");
+        }
+        parsed.facing = static_cast<uint8_t>(facing);
+        parsed.moving = motion == "walk";
+        actors.push_back(std::move(parsed));
+    }
+    JS_FreeValue(ctx, units);
+    BridgeApplySnapshot(std::move(session), static_cast<uint64_t>(seq), std::move(actors));
+    return JS_NewBool(ctx, true);
+}
