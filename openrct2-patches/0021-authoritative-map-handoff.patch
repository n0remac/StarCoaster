+        return value == nullptr ? "" : value;
+    }
+
+    json_t StarCoasterRequest(const std::string& url, const std::string& route,
+                              OpenRCT2::Http::Method method = OpenRCT2::Http::Method::get,
+                              const std::string& body = "", const std::string& filename = "")
+    {
+        OpenRCT2::Http::Request request;
+        request.url = url + "/private/park-session" + route;
+        request.method = method;
+        request.body = body;
+        if (method == OpenRCT2::Http::Method::post)
+        {
+            request.header["Content-Type"] = filename.empty() ? "application/json" : "application/octet-stream";
+            auto authorityEnd = url.find('/', url.find("://") + 3);
+            request.header["Origin"] = url.substr(0, authorityEnd);
+            if (!filename.empty())
+                request.header["X-StarCoaster-Filename"] = filename;
+        }
+        auto response = OpenRCT2::Http::Do(request);
+        if (static_cast<int>(response.status) < 200 || static_cast<int>(response.status) >= 300)
+        {
+            std::string reason = response.error.empty() ? response.body : response.error;
+            throw std::runtime_error("authoritative session request failed: " + reason.substr(0, 240));
+        }
+        return OpenRCT2::Json::FromString(response.body);
+    }
+#endif
+}
+
+bool StarCoasterRequestMapLoad(const char* path, bool scenario)
+{
+#ifdef __EMSCRIPTEN__
+    return MAIN_THREAD_EM_ASM_INT({
+        if (!window.starcoasterMapLoad) return 0;
+        window.starcoasterMapLoad(UTF8ToString($0), $1 !== 0);
+        return 1;
+    }, path, scenario ? 1 : 0) != 0;
+#elif !defined(DISABLE_HTTP)
+    const auto url = StarCoasterControlURL();
+    if (url.empty())
+    {
+        OpenRCT2::Console::Error::WriteLine("StarCoaster synchronization is offline; loading the park locally");
+        ContextShowError(STR_UNABLE_TO_CONNECT_TO_SERVER, kStringIdNone, {});
+        return false;
+    }
+    if (starCoasterWorker.valid())
+        return true;
+    const auto source = std::string(path);
+    starCoasterWorker = std::async(std::launch::async, [url, source, scenario]() -> StarCoasterResult {
+        try
+        {
+            auto before = StarCoasterRequest(url, "");
+            const auto previous = before.value("generation", std::string());
+            auto name = std::filesystem::path(source).filename().string();
+            if (!scenario)
+            {
+                std::ifstream file(source, std::ios::binary | std::ios::ate);
+                if (!file)
+                    throw std::runtime_error("cannot read selected save");
+                auto size = file.tellg();
+                if (size < 4 || size > 64 * 1024 * 1024)
+                    throw std::runtime_error("selected save exceeds the 64 MiB upload limit");
+                std::string bytes(static_cast<size_t>(size), '\0');
+                file.seekg(0);
+                file.read(bytes.data(), bytes.size());
+                auto suffix = std::filesystem::path(source).extension().string();
+                auto uploaded = StarCoasterRequest(url, "/upload", OpenRCT2::Http::Method::post,
+                                                   bytes, "selected" + suffix);
+                name = uploaded.value("park", std::string());
+            }
+            json_t selection = { { "park", name }, { "decision", "discard" }, { "generation", previous } };
+            StarCoasterRequest(url, "/load", OpenRCT2::Http::Method::post, selection.dump());
+            for (int attempt = 0; attempt < 480; ++attempt)
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds(500));
+                auto state = StarCoasterRequest(url, "");
+                auto phase = state.value("phase", std::string());
+                auto generation = state.value("generation", std::string());
+                if (phase == "ready" && !generation.empty() && generation != previous)
+                {
+                    auto failure = state.value("error", std::string());
+                    if (!failure.empty() || state.value("current", std::string()) != name)
+                        throw std::runtime_error(failure.empty() ? "authoritative host restored another map" : failure);
+                    return { generation, "" };
+                }
+                auto error = state.value("error", std::string());
+                if (!error.empty() && (phase == "failed" || phase == "idle" || phase == "ready"))
+                    throw std::runtime_error(error);
+            }
+            throw std::runtime_error("authoritative session did not become ready in time");
+        }
+        catch (const std::exception& error)
+        {
+            return { "", error.what() };
+        }
+    });
+    return true;
+#else
+    return false;
+#endif
+}
+
+void StarCoasterSessionTick()
+{
+#if !defined(__EMSCRIPTEN__) && !defined(DISABLE_HTTP)
+    if (starCoasterObserver.valid() &&
+        starCoasterObserver.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+    {
+        auto observed = starCoasterObserver.get();
+        if (!starCoasterWorker.valid() && !observed.generation.empty())
+        {
+            if (starCoasterGeneration.empty() && OpenRCT2::Network::GetMode() == OpenRCT2::Network::Mode::client)
+            {
+                // A client joined an already running park through the ordinary multiplayer interface.
+                starCoasterGeneration = observed.generation;
+            }
+            else if (starCoasterGeneration != observed.generation)
+            {
+                if (OpenRCT2::Network::GetMode() == OpenRCT2::Network::Mode::client)
+                    GetContext()->GetNetwork().Close();
+                const char* host = std::getenv("STARCOASTER_MULTIPLAYER_HOST");
+                const char* portValue = std::getenv("STARCOASTER_MULTIPLAYER_PORT");
+                int port = portValue == nullptr ? OpenRCT2::Network::kDefaultPort : std::atoi(portValue);
+                if (port < 1 || port > 65535)
+                    port = OpenRCT2::Network::kDefaultPort;
+                if (OpenRCT2::Network::BeginClient(host == nullptr ? "127.0.0.1" : host, port))
+                    starCoasterGeneration = observed.generation;
+                else
+                    ContextShowError(STR_UNABLE_TO_CONNECT_TO_SERVER, kStringIdNone, {});
+            }
+        }
+    }
+    if (!starCoasterWorker.valid())
+    {
+        auto now = std::chrono::steady_clock::now();
+        if (!starCoasterObserver.valid() && now >= starCoasterNextPoll &&
+            (OpenRCT2::Network::GetMode() == OpenRCT2::Network::Mode::client || !starCoasterGeneration.empty()))
+        {
+            starCoasterNextPoll = now + std::chrono::seconds(2);
+            const auto url = StarCoasterControlURL();
+            if (!url.empty())
+                starCoasterObserver = std::async(std::launch::async, [url]() -> StarCoasterResult {
+                    try
+                    {
+                        auto state = StarCoasterRequest(url, "");
+                        if (state.value("phase", std::string()) == "ready")
+                            return { state.value("generation", std::string()), "" };
+                    }
+                    catch (const std::exception&)
+                    {
+                    }
+                    return {};
+                });
+        }
+        return;
+    }
+    if (starCoasterWorker.wait_for(std::chrono::seconds(0)) != std::future_status::ready)
+        return;
+    auto result = starCoasterWorker.get();
+    if (!result.error.empty())
+    {
+        OpenRCT2::Console::Error::WriteLine("StarCoaster synchronization failed: %s", result.error.c_str());
+        ContextShowError(STR_UNABLE_TO_CONNECT_TO_SERVER, kStringIdNone, {});
+        return;
+    }
+    if (OpenRCT2::Network::GetMode() == OpenRCT2::Network::Mode::client)
+        GetContext()->GetNetwork().Close();
+    starCoasterGeneration = result.generation;
+    const char* host = std::getenv("STARCOASTER_MULTIPLAYER_HOST");
+    const char* portValue = std::getenv("STARCOASTER_MULTIPLAYER_PORT");
+    int port = portValue == nullptr ? OpenRCT2::Network::kDefaultPort : std::atoi(portValue);
+    if (port < 1 || port > 65535)
+        port = OpenRCT2::Network::kDefaultPort;
+    if (!OpenRCT2::Network::BeginClient(host == nullptr ? "127.0.0.1" : host, port))
+        ContextShowError(STR_UNABLE_TO_CONNECT_TO_SERVER, kStringIdNone, {});
+#endif
+}
+
+void StarCoasterReturnToTitle()
+{
+#ifdef __EMSCRIPTEN__
+    MAIN_THREAD_EM_ASM({ if (window.starcoasterReturnToTitle) window.starcoasterReturnToTitle(); });
+#elif !defined(DISABLE_HTTP)
+    if (starCoasterGeneration.empty())
+        return;
+    const auto generation = std::exchange(starCoasterGeneration, std::string());
+    const auto url = StarCoasterControlURL();
+    std::thread([url, generation] {
+        try
+        {
+            json_t request = { { "generation", generation } };
+            StarCoasterRequest(url, "/title", OpenRCT2::Http::Method::post, request.dump());
+        }
+        catch (const std::exception& error)
+        {
+            OpenRCT2::Console::Error::WriteLine("StarCoaster title cleanup failed: %s", error.what());
+        }
+    }).detach();
+#endif
+}
