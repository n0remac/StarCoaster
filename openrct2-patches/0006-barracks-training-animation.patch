+static JSValue BridgeSetBuildingAnimationsJS(JSContext* ctx, JSValueConst, int argc, JSValueConst* argv)
+{
+    if (argc != 1 || !JS_IsObject(argv[0]))
+        return JS_ThrowTypeError(ctx, "expected one building animation object");
+    std::string session;
+    int32_t objectIndex = -1;
+    if (!BridgeReadString(ctx, argv[0], "session", session) || session.empty() || session.size() > 64
+        || !BridgeReadInt(ctx, argv[0], "object", objectIndex) || objectIndex < 0 || objectIndex > 65535)
+        return JS_ThrowTypeError(ctx, "invalid building animation session or object");
+    JSValue tiles = JS_GetPropertyStr(ctx, argv[0], "tiles");
+    JSValue lengthValue = JS_GetPropertyStr(ctx, tiles, "length");
+    int32_t length = -1;
+    const bool validLength = JS_IsArray(tiles) && JS_ToInt32(ctx, &length, lengthValue) == 0
+        && length >= 0 && length <= 4096;
+    JS_FreeValue(ctx, lengthValue);
+    if (!validLength)
+    {
+        JS_FreeValue(ctx, tiles);
+        return JS_ThrowTypeError(ctx, "building animation must contain at most 4096 tiles");
+    }
+    std::set<std::pair<int32_t, int32_t>> positions;
+    const auto mapSize = GetMapSizeUnits();
+    for (int32_t index = 0; index < length; ++index)
+    {
+        JSValue tile = JS_GetPropertyUint32(ctx, tiles, index);
+        int32_t x = -1, y = -1;
+        const bool valid = JS_IsObject(tile) && BridgeReadInt(ctx, tile, "x", x)
+            && BridgeReadInt(ctx, tile, "y", y) && x >= 0 && y >= 0 && x < mapSize.x && y < mapSize.y
+            && x % 32 == 0 && y % 32 == 0;
+        JS_FreeValue(ctx, tile);
+        if (!valid)
+        {
+            JS_FreeValue(ctx, tiles);
+            return JS_ThrowTypeError(ctx, "invalid building animation tile");
+        }
+        positions.emplace(x, y);
+    }
+    JS_FreeValue(ctx, tiles);
+    BridgeSetBuildingAnimations(std::move(session), objectIndex, std::move(positions));
+    return JS_UNDEFINED;
+}
