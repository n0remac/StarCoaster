+
+void BridgeSetBuildingAnimations(std::string session, int32_t objectIndex, std::set<std::pair<int32_t, int32_t>> tiles)
+{
+    auto previous = std::atomic_load(&gBridgeBuildingAnimations);
+    if (previous->session == session && previous->objectIndex == objectIndex && previous->tiles == tiles)
+        return;
+    InvalidateBuildingTiles(*previous);
+    auto next = std::make_shared<BridgeBuildingAnimations>();
+    next->session = std::move(session);
+    next->objectIndex = objectIndex;
+    next->tiles = std::move(tiles);
+    std::atomic_store(&gBridgeBuildingAnimations, std::shared_ptr<const BridgeBuildingAnimations>(next));
+    InvalidateBuildingTiles(*next);
+}
+
+uint32_t BridgeBuildingAnimationFrame(int32_t objectIndex, const CoordsXY& position)
+{
+    const auto animation = std::atomic_load(&gBridgeBuildingAnimations);
+    if (animation->session != std::atomic_load(&gBridgeSnapshot)->session || animation->objectIndex != objectIndex
+        || !animation->tiles.contains({ position.x, position.y }))
+        return 0;
+    // Banks 1..7 contain classic Barracks GRP frames 2..8. Frame 1 is the
+    // unfinished structure and does not belong in the production loop.
+    return 1 + (getGameState().currentTicks / 3) % 7;
 }
 
