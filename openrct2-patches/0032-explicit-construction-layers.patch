diff --git a/src/openrct2/paint/BridgeConstructionLayers.h b/src/openrct2/paint/BridgeConstructionLayers.h
new file mode 100644
--- /dev/null
+++ b/src/openrct2/paint/BridgeConstructionLayers.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <vector>
+
+// Reorder only paint entries whose caller confirms the same visible construction
+// site. An SCV paints after unfinished art and before completed art; all other
+// entries retain their existing painter order.
+template<typename Node, typename IsSCV, typename IsUnfinished, typename IsComplete, typename Overlaps>
+void BridgeOrderConstructionLayers(
+    Node*& head, IsSCV isSCV, IsUnfinished isUnfinished, IsComplete isComplete, Overlaps overlaps)
+{
+    std::vector<Node*> scvs;
+    for (Node* node = head; node; node = node->NextQuadrantEntry)
+        if (isSCV(node))
+            scvs.push_back(node);
+
+    for (Node* scv : scvs)
+    {
+        // Completed scenery already behind this SCV must move just ahead of it
+        // in draw order. Preserve the relative order of its scenery tiles.
+        Node* completeTail = scv;
+        Node** link = &head;
+        while (*link && *link != scv)
+        {
+            Node* node = *link;
+            if (isComplete(node) && overlaps(scv, node))
+            {
+                *link = node->NextQuadrantEntry;
+                node->NextQuadrantEntry = completeTail->NextQuadrantEntry;
+                completeTail->NextQuadrantEntry = node;
+                completeTail = node;
+            }
+            else
+                link = &node->NextQuadrantEntry;
+        }
+
+        Node** beforeSCV = &head;
+        while (*beforeSCV && *beforeSCV != scv)
+            beforeSCV = &(*beforeSCV)->NextQuadrantEntry;
+        if (!*beforeSCV)
+            continue;
+        Node** after = &completeTail->NextQuadrantEntry;
+        while (*after)
+        {
+            Node* node = *after;
+            if (isUnfinished(node) && overlaps(scv, node))
+            {
+                *after = node->NextQuadrantEntry;
+                node->NextQuadrantEntry = scv;
+                *beforeSCV = node;
+                beforeSCV = &node->NextQuadrantEntry;
+            }
+            else
+                after = &node->NextQuadrantEntry;
+        }
+    }
+}
