+static bool BridgePaintImagesOverlap(const PaintStruct* scv, const PaintStruct* building)
+{
+    // Keep the exception local to a nearby building on the same ground level.
+    // The screen rectangles then account for all four camera rotations and
+    // for artwork extending beyond the building's map tiles.
+    if (std::abs(scv->MapPos.x - building->MapPos.x) > 160
+        || std::abs(scv->MapPos.y - building->MapPos.y) > 160
+        || std::abs(scv->Bounds.z - 5 - building->Bounds.z) > 16)
+        return false;
+    const auto* scvImage = GfxGetG1Element(scv->image_id);
+    const auto* buildingImage = GfxGetG1Element(building->image_id);
+    if (!scvImage || !buildingImage)
+        return false;
+    const int32_t scvLeft = scv->ScreenPos.x + scvImage->xOffset;
+    const int32_t scvTop = scv->ScreenPos.y + scvImage->yOffset;
+    const int32_t buildingLeft = building->ScreenPos.x + buildingImage->xOffset;
+    const int32_t buildingTop = building->ScreenPos.y + buildingImage->yOffset;
+    return scvLeft < buildingLeft + buildingImage->width
+        && buildingLeft < scvLeft + scvImage->width
+        && scvTop < buildingTop + buildingImage->height
+        && buildingTop < scvTop + scvImage->height;
+}
