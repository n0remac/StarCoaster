 #include "../drawing/LightFX.h"
 #include "../entity/EntityList.h"
 #include "../entity/Staff.h"
@@ -16,6 +17,7 @@
 #include "../profiling/Profiling.h"
 #include "../ride/TrackDesign.h"
 #include "../world/Map.h"
+#include "../world/tile_element/SurfaceElement.h"
 #include "Paint.h"
 #include "entity/Paint.Balloon.h"
 #include "entity/Paint.CrashSplashParticle.h"
@@ -180,3 +182,27 @@ void EntityPaintSetup(PaintSession& session, const CoordsXY& pos)
         }
     }
 }
+
+// M1 paint-pipeline probe. The synchronized bridge registry will replace this fixed
+// actor after the art, occlusion, and rotation can be inspected in a graphical client.
+void PaintBridgeActors(PaintSession& session, const CoordsXY& pos)
+{
+    constexpr CoordsXY actorPos{ 320, 480 };
+    if (pos != actorPos.toTileStart() || !MapIsLocationValid(actorPos))
+        return;
+    if (gTrackDesignSaveMode || session.ViewFlags.has(ViewportFlag::hideEntities) || session.rt.zoom_level > ZoomLevel{ 2 })
+        return;
+
+    auto* surface = MapGetSurfaceElementAt(actorPos);
+    if (surface == nullptr)
+        return;
+
+    session.SpritePosition = actorPos;
+    session.MapPosition = pos;
+    session.CurrentlyDrawnEntity = nullptr;
+    session.CurrentlyDrawnTileElement = nullptr;
+    session.InteractionType = ViewportInteractionItem::none;
+    const int32_t z = surface->getBaseZ();
+    const uint32_t imageId = SPR_BRIDGE_SCOUT_IDLE_EAST + session.CurrentRotation;
+    PaintAddImageAsParent(session, ImageId(imageId), { 0, 0, z }, { { -5, -5, z + 1 }, { 10, 10, 17 } });
+}
