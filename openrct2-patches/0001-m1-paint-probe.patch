diff --git a/src/openrct2/paint/Paint.cpp b/src/openrct2/paint/Paint.cpp
index 7aea6d1..6e3f788 100644
--- a/src/openrct2/paint/Paint.cpp
+++ b/src/openrct2/paint/Paint.cpp
@@ -297,16 +297,20 @@ void PaintSessionGenerateRotate(PaintSession& session)
     {
         TileElementPaintSetup(session, mapTile);
         EntityPaintSetup(session, mapTile);
+        PaintBridgeActors(session, mapTile);
 
         const auto loc1 = mapTile + adjacentTiles[0];
         EntityPaintSetup(session, loc1);
+        PaintBridgeActors(session, loc1);
 
         const auto loc2 = mapTile + adjacentTiles[1];
         TileElementPaintSetup(session, loc2);
         EntityPaintSetup(session, loc2);
+        PaintBridgeActors(session, loc2);
 
         const auto loc3 = mapTile + adjacentTiles[2];
         EntityPaintSetup(session, loc3);
+        PaintBridgeActors(session, loc3);
 
         mapTile += nextVerticalTile;
     }
