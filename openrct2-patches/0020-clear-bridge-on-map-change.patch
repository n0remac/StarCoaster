+void BridgeClearSnapshot()
+{
+    auto previous = std::atomic_load(&gBridgeSnapshot);
+    for (const auto& actor : previous->actors)
+        InvalidateBridgeActor(actor);
+    auto animations = std::atomic_load(&gBridgeBuildingAnimations);
+    for (const auto& [objectIndex, state] : animations->objects)
+        InvalidateBuildingTiles(state.tiles);
+    std::atomic_store(&gBridgeSnapshot, std::shared_ptr<const BridgeSnapshot>(std::make_shared<BridgeSnapshot>()));
+    std::atomic_store(&gBridgeBuildingAnimations,
+        std::shared_ptr<const BridgeBuildingAnimations>(std::make_shared<BridgeBuildingAnimations>()));
+}
+
