+                || screenCoords.y >= window->viewport->pos.y + window->viewport->height))
+        {
+            InvokeViewportInteraction(&CustomTool::onFinish, screenCoords);
+            return false;
+        }
+        if (event == &CustomTool::onDown) ViewportInteraction->MouseDown = true;
+        if (event == &CustomTool::onUp || event == &CustomTool::onFinish) ViewportInteraction->MouseDown = false;
+        // Keep the owner and callbacks alive if the plugin unregisters during the call.
+        auto interaction = *ViewportInteraction;
+        return interaction.InvokeEventHandler((interaction.*event).callback, screenCoords);
