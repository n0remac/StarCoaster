diff --git a/src/openrct2/paint/BridgePerformance.h b/src/openrct2/paint/BridgePerformance.h
new file mode 100644
--- /dev/null
+++ b/src/openrct2/paint/BridgePerformance.h
@@ -0,0 +1,100 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+
+// Diagnostics remain local to the patched engine. WASM stderr is captured by
+// the browser harness; native stderr is captured by the session launcher.
+namespace BridgePerf
+{
+    inline bool enabled()
+    {
+        static const bool value = [] { const char* v = std::getenv("STARCOASTER_PERF"); return v && *v == '1'; }();
+        return value;
+    }
+
+    inline bool suppressPainting()
+    {
+        static const bool value = [] { const char* v = std::getenv("STARCOASTER_SUPPRESS_PAINT"); return v && *v == '1'; }();
+        return value;
+    }
+
+    inline int64_t nowNS()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    inline void event(const char* stage, uint64_t seq, size_t actors, int64_t durationUS, int64_t otherUS = 0)
+    {
+        if (!enabled()) return;
+        std::fprintf(stderr, "STARCOASTER_PERF {\"source\":\"openrct2\",\"stage\":\"%s\","
+            "\"mono_ns\":%lld,\"seq\":%llu,\"actors\":%zu,\"duration_us\":%lld,\"other_us\":%lld}\n",
+            stage, static_cast<long long>(nowNS()), static_cast<unsigned long long>(seq), actors,
+            static_cast<long long>(durationUS), static_cast<long long>(otherUS));
+    }
+
+    inline std::atomic<uint64_t> invalidations{0}, paintCalls{0}, actorsConsidered{0}, actorsPainted{0};
+    inline std::atomic<uint64_t> latestSnapshotSeq{0};
+    inline std::atomic<int64_t> invalidationUS{0}, animationUS{0}, paintUS{0}, spriteUS{0}, healthUS{0};
+    inline std::atomic<uint64_t> animationCalls{0};
+
+    struct PaintScope
+    {
+        int64_t started = enabled() ? nowNS() : 0;
+        ~PaintScope()
+        {
+            if (started) {
+                paintCalls.fetch_add(1, std::memory_order_relaxed);
+                paintUS.fetch_add((nowNS() - started) / 1000, std::memory_order_relaxed);
+            }
+        }
+    };
+
+    inline void presented(int64_t beganNS, int64_t endNS)
+    {
+        if (!enabled()) return;
+        static std::array<int64_t, 256> intervals{};
+        static size_t count = 0;
+        static int64_t windowNS = endNS;
+        static int64_t previousNS = 0;
+        static int64_t maxRenderUS = 0;
+        static uint64_t lastPresentedSeq = 0;
+        const auto currentSeq = latestSnapshotSeq.load(std::memory_order_relaxed);
+        if (currentSeq && currentSeq != lastPresentedSeq)
+        {
+            event("snapshot_present", currentSeq, 0, (endNS - beganNS) / 1000);
+            lastPresentedSeq = currentSeq;
+        }
+        if (previousNS && count < intervals.size()) intervals[count++] = (endNS - previousNS) / 1000;
+        previousNS = endNS;
+        maxRenderUS = std::max(maxRenderUS, (endNS - beganNS) / 1000);
+        if (endNS - windowNS < 1000000000LL) return;
+        std::sort(intervals.begin(), intervals.begin() + count);
+        const auto at = [&](double p) -> int64_t { return count ? intervals[static_cast<size_t>((count - 1) * p)] : 0; };
+        std::fprintf(stderr, "STARCOASTER_PERF {\"source\":\"openrct2\",\"stage\":\"present_summary\","
+            "\"mono_ns\":%lld,\"frames\":%zu,\"elapsed_ns\":%lld,\"frame_p50_us\":%lld,"
+            "\"frame_p95_us\":%lld,\"frame_p99_us\":%lld,\"frame_max_us\":%lld,"
+            "\"render_max_us\":%lld,\"invalidations\":%llu,\"invalidation_us\":%lld,"
+            "\"animation_calls\":%llu,\"animation_us\":%lld,\"paint_calls\":%llu,\"paint_us\":%lld,\"actors_considered\":%llu,"
+            "\"actors_painted\":%llu,\"sprite_us\":%lld,\"health_us\":%lld}\n",
+            static_cast<long long>(endNS), count, static_cast<long long>(endNS - windowNS),
+            static_cast<long long>(at(.50)), static_cast<long long>(at(.95)),
+            static_cast<long long>(at(.99)), static_cast<long long>(at(1.0)),
+            static_cast<long long>(maxRenderUS),
+            static_cast<unsigned long long>(invalidations.exchange(0)),
+            static_cast<long long>(invalidationUS.exchange(0)),
+            static_cast<unsigned long long>(animationCalls.exchange(0)),
+            static_cast<long long>(animationUS.exchange(0)),
+            static_cast<unsigned long long>(paintCalls.exchange(0)),
+            static_cast<long long>(paintUS.exchange(0)),
+            static_cast<unsigned long long>(actorsConsidered.exchange(0)),
+            static_cast<unsigned long long>(actorsPainted.exchange(0)),
+            static_cast<long long>(spriteUS.exchange(0)), static_cast<long long>(healthUS.exchange(0)));
+        count = 0; maxRenderUS = 0; windowNS = endNS;
+    }
+}
