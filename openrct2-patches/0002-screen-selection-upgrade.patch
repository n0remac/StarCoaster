+std::optional<std::pair<int32_t, int32_t>> BridgeActorScreenPosition(const std::string& id)
+{
+    const auto* mainWindow = WindowGetMain();
+    const auto* viewport = mainWindow == nullptr ? nullptr : mainWindow->viewport;
+    if (viewport == nullptr) return std::nullopt;
+    const auto snapshot = std::atomic_load(&gBridgeSnapshot);
+    const auto actor = std::find_if(snapshot->actors.begin(), snapshot->actors.end(),
+        [&](const BridgeActor& item) { return item.id == id; });
+    if (actor == snapshot->actors.end() || actor->motion == "death") return std::nullopt;
+    const auto visual = snapshot->visual.find(id);
+    if (visual == snapshot->visual.end()) return std::nullopt;
+    const auto position = VisualPosition(*actor, visual->second);
+    if (!MapIsLocationValid(position)) return std::nullopt;
+    const auto projected = Translate3DTo2DWithZ(viewport->rotation,
+        { position, TileElementHeight(position) });
+    return std::pair<int32_t, int32_t>{
+        viewport->pos.x + viewport->zoom.ApplyInversedTo(projected.x - viewport->viewPos.x),
+        viewport->pos.y + viewport->zoom.ApplyInversedTo(projected.y - viewport->viewPos.y) };
 }

