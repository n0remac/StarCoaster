+static JSValue BridgeActorScreenPositionJS(JSContext* ctx, JSValueConst, int argc, JSValueConst* argv)
+{
+    if (argc != 1 || !JS_IsString(argv[0]))
+        return JS_ThrowTypeError(ctx, "expected actor id");
+    const char* text = JS_ToCString(ctx, argv[0]);
+    if (text == nullptr) return JS_EXCEPTION;
+    const std::string id(text);
+    JS_FreeCString(ctx, text);
+    const auto position = BridgeActorScreenPosition(id);
+    if (!position) return JS_NULL;
+    JSValue point = JS_NewObject(ctx);
+    JS_SetPropertyStr(ctx, point, "x", JS_NewInt32(ctx, position->first));
+    JS_SetPropertyStr(ctx, point, "y", JS_NewInt32(ctx, position->second));
+    return point;
+}
