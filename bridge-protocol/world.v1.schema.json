{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starcoaster.local/bridge-protocol/world.v1.schema.json",
  "title": "StarCoaster world.v1 envelope",
  "type": "object",
  "required": ["v", "kind", "session", "op_id", "source", "revision", "payload"],
  "properties": {
    "v": { "const": 1 },
    "kind": { "enum": ["world.hello", "world.snapshot.begin", "world.snapshot.chunk", "world.snapshot.end", "world.patch", "world.patch.query", "world.patch.status", "world.patch.targets", "world.targets.status", "world.ready", "world.start", "world.outcome", "world.resync", "world.ack", "world.error", "entity.upsert", "entity.remove", "entity.target", "entity.retire", "entity.transform", "entity.state", "building.state", "player.resources", "actor.spawn", "actor.bind", "actor.morph", "actor.despawn", "actor.reconcile", "unit.spawn.request", "unit.spawn.execute", "unit.spawn.status", "unit.spawn.query", "unit.spawn.cancel", "unit.spawn.reconcile", "combat.command", "combat.snapshot", "combat.event", "combat.result", "navigation.obstacle.upsert", "navigation.obstacle.remove", "navigation.terrain.update", "navigation.mask.begin", "navigation.mask.chunk", "navigation.mask.end", "navigation.revision.stage", "navigation.mask.schedule", "navigation.mask.cancel", "navigation.mask.staged", "navigation.mask.scheduled", "navigation.mask.applied"] },
    "session": { "type": "string", "minLength": 1, "maxLength": 128 },
    "op_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "enum": ["openrct2", "openbw", "bridge"] },
    "revision": { "type": "integer", "minimum": 1 },
    "bw_tick": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "world.patch" } } }, "then": { "properties": { "source": { "const": "openrct2" }, "payload": { "$ref": "#/$defs/worldPatch" } } } },
    { "if": { "properties": { "kind": { "const": "world.patch.query" } } }, "then": { "properties": { "source": { "const": "openrct2" }, "payload": { "type": "object", "required": ["patch_id"], "properties": { "patch_id": { "type": "string", "minLength": 1, "maxLength": 128 } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "world.patch.status" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["patch_id", "state"], "properties": { "patch_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "state": { "enum": ["staged", "scheduled", "synchronized", "failed", "unsynchronized"] }, "navigation_hash": { "$ref": "#/$defs/navigationHash" }, "apply_frame": { "type": "integer", "minimum": 0 }, "reason": { "type": "string" }, "unsupported_total": { "type": "integer", "minimum": 0 }, "unsupported_reasons": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "world.patch.targets" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["patch_id", "additions", "modifications", "removals"], "properties": { "patch_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "additions": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/entity" } }, "modifications": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/entity" } }, "removals": { "type": "array", "maxItems": 4096, "items": { "type": "string" } } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "world.targets.status" } } }, "then": { "properties": { "source": { "const": "openbw" }, "payload": { "type": "object", "required": ["patch_id", "targets", "unsupported_total"], "properties": { "patch_id": { "type": "string" }, "targets": { "type": "integer", "minimum": 0 }, "unsupported_total": { "type": "integer", "minimum": 0 }, "unsupported": { "type": "array" }, "unsupported_reasons": { "type": "object" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "navigation.mask.cancel" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["hash"], "properties": { "hash": { "$ref": "#/$defs/navigationHash" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "entity.retire" } } }, "then": { "properties": { "source": { "const": "openbw" }, "payload": { "type": "object", "required": ["id", "proxy_id", "reason"], "properties": { "id": { "type": "string" }, "proxy_id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "reason": { "const": "controlled_replacement" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "entity.target" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["id", "proxy_id", "proxy_x", "proxy_y"], "properties": { "id": { "type": "string" }, "proxy_id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "proxy_x": { "type": "integer", "minimum": 0 }, "proxy_y": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "combat.command" } } }, "then": { "properties": { "payload": { "type": "object", "required": ["command_id", "player_id", "request_id", "unit_ids", "verb"], "properties": { "command_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "player_id": { "type": "integer", "minimum": 0 }, "request_id": { "type": "integer", "minimum": 1 }, "unit_ids": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^openbw:[0-9]+$" } }, "verb": { "enum": ["unit.move", "unit.attack", "unit.attack_move", "unit.hold", "unit.stop", "unit.heal", "unit.train"] }, "unit_type": { "enum": ["terran_marine", "terran_firebat", "terran_medic", "terran_vulture", "terran_goliath", "zerg_zergling", "zerg_hydralisk", "zerg_ultralisk", "zerg_larva", "zerg_egg"] }, "target_id": { "type": "string" }, "target_proxy_id": { "type": "string" }, "x": { "type": "integer" }, "y": { "type": "integer" } }, "additionalProperties": false } } } },
    {"if": {"properties": {"kind": {"const": "building.state"}}}, "then": {"properties": {"source": {"enum": ["openbw", "bridge"]}, "payload": {"type": "object", "required": ["id", "native_id", "owner", "health", "queue", "remaining_frames"], "properties": {"id": {"type": "string"}, "native_id": {"type": "string", "pattern": "^openbw:[0-9]+$"}, "owner": {"type": "integer", "minimum": 0}, "health": {"type": "integer", "minimum": 0}, "max_health": {"type": "integer", "minimum": 1}, "queue": {"type": "integer", "minimum": 0}, "remaining_frames": {"type": "integer", "minimum": 0}, "minerals": {"type": "integer", "minimum": 0}, "gas": {"type": "integer", "minimum": 0}, "availability": {"type": "object", "additionalProperties": {"type": "object", "required": ["ready", "reason", "requirement"], "properties": {"ready": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1, "maxLength": 64}, "requirement": {"type": "string", "maxLength": 64}}, "additionalProperties": false}}, "supply_used": {"type": "integer", "minimum": 0}, "supply_total": {"type": "integer", "minimum": 0}, "race": {"type": "string"}, "completed": {"type": "boolean"}, "command_authorized": {"type": "boolean"}, "larva_count": {"type": "integer", "minimum": 0}, "commands": {"type": "array", "maxItems": 9, "items": {"type": "object", "required": ["slot", "action", "unit_type", "label", "ready", "reason", "requirement"], "properties": {"slot": {"type": "integer", "minimum": 0, "maximum": 8}, "action": {"type": "string"}, "unit_type": {"type": "string"}, "label": {"type": "string"}, "ready": {"type": "boolean"}, "reason": {"type": "string"}, "requirement": {"type": "string"}}, "additionalProperties": false}}, "morph_count": {"type": "integer", "minimum": 0}, "morph_remaining_frames": {"type": "integer", "minimum": 0}, "supply_provided": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}}},
    { "if": { "properties": { "kind": { "const": "player.resources" } } }, "then": { "properties": { "source": { "enum": ["openbw", "bridge"] }, "payload": { "type": "object", "required": ["owner", "minerals", "gas", "supply_used", "supply_total"], "properties": { "owner": { "type": "integer", "minimum": 0 }, "minerals": { "type": "integer", "minimum": 0 }, "gas": { "type": "integer", "minimum": 0 }, "supply_used": { "type": "integer", "minimum": 0 }, "supply_total": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "actor.spawn" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/actorIdentity" } } } },
    { "if": { "properties": { "kind": { "const": "actor.bind" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/actorBinding" } } } },
    {"if": {"properties": {"kind": {"const": "actor.morph"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/actorMorph"}}}},
    { "if": { "properties": { "kind": { "const": "actor.despawn" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/actorDespawn" } } } },
    { "if": { "properties": { "kind": { "const": "actor.reconcile" } } }, "then": { "properties": { "payload": { "type": "object", "description": "Complete OpenBW living actor set used after reconnect; missing known actors are despawned.", "required": ["living"], "properties": { "living": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/actorIdentity" } } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "unit.spawn.request" } } }, "then": { "properties": { "source": { "const": "openrct2" }, "payload": { "$ref": "#/$defs/spawnRequest" } } } },
    { "if": { "properties": { "kind": { "const": "unit.spawn.execute" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "$ref": "#/$defs/spawnExecute" } } } },
    { "if": { "properties": { "kind": { "const": "unit.spawn.reconcile" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["pending"], "properties": { "pending": { "type": "array", "maxItems": 64, "items": { "type": "object", "required": ["request_id", "index"], "properties": { "request_id": { "$ref": "#/$defs/spawnRequestID" }, "index": { "type": "integer", "minimum": 0, "maximum": 4 } }, "additionalProperties": false } } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "enum": ["unit.spawn.query", "unit.spawn.cancel"] } } }, "then": { "properties": { "source": { "const": "openrct2" }, "payload": { "type": "object", "required": ["request_id"], "properties": { "request_id": { "$ref": "#/$defs/spawnRequestID" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "unit.spawn.status" } } }, "then": { "properties": { "payload": { "oneOf": [{ "$ref": "#/$defs/spawnStatus" }, { "$ref": "#/$defs/nativeSpawnStatus" }] } } } },
    { "if": { "properties": { "kind": { "const": "navigation.mask.begin" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["width", "height", "chunks", "hash", "apply_frame"], "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 256 }, "height": { "type": "integer", "minimum": 1, "maximum": 256 }, "chunks": { "type": "integer", "minimum": 1, "maximum": 256 }, "hash": { "$ref": "#/$defs/navigationHash" }, "apply_frame": { "type": "integer", "minimum": 0 }, "stage_only": { "type": "boolean" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "navigation.revision.stage" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["hash"], "properties": { "hash": { "$ref": "#/$defs/navigationHash" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "navigation.mask.schedule" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["hash", "apply_frame"], "properties": { "hash": { "$ref": "#/$defs/navigationHash" }, "apply_frame": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "enum": ["navigation.mask.staged", "navigation.mask.scheduled"] } } }, "then": { "properties": { "source": { "const": "openbw" }, "payload": { "type": "object", "required": ["hash", "accepted", "error"], "properties": { "hash": { "$ref": "#/$defs/navigationHash" }, "accepted": { "type": "boolean" }, "error": { "type": "string" }, "apply_frame": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "navigation.mask.chunk" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["index", "hex"], "properties": { "index": { "type": "integer", "minimum": 0, "maximum": 255 }, "hex": { "type": "string", "pattern": "^[0-9a-f]+$", "maxLength": 12000 } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "navigation.mask.end" } } }, "then": { "properties": { "source": { "const": "bridge" }, "payload": { "type": "object", "required": ["hash"], "properties": { "hash": { "$ref": "#/$defs/navigationHash" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "navigation.mask.applied" } } }, "then": { "properties": { "source": { "const": "openbw" }, "payload": { "type": "object", "required": ["hash", "accepted", "error"], "properties": { "hash": { "$ref": "#/$defs/navigationHash" }, "accepted": { "type": "boolean" }, "error": { "type": "string" } }, "additionalProperties": false } } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "worldPatch": { "type": "object", "required": ["patch_id", "base_revision", "result_revision", "additions", "modifications", "removals", "terrain", "counts"], "properties": { "patch_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.:/#-]{1,128}$" }, "base_revision": { "type": "integer", "minimum": 1 }, "result_revision": { "type": "integer", "minimum": 2 }, "additions": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/entity" } }, "modifications": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/entity" } }, "removals": { "type": "array", "maxItems": 4096, "items": { "type": "string" } }, "terrain": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/terrain" } }, "counts": { "type": "object", "required": ["additions", "modifications", "removals", "terrain"], "properties": { "additions": { "type": "integer", "minimum": 0 }, "modifications": { "type": "integer", "minimum": 0 }, "removals": { "type": "integer", "minimum": 0 }, "terrain": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false },
    "navigationHash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "actorIdentity": { "type": "object", "required": ["id", "engine", "type", "owner", "generation", "session"], "properties": { "id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "engine": { "const": "openbw" }, "type": { "enum": ["terran_marine", "terran_firebat", "terran_medic", "terran_vulture", "terran_goliath", "zerg_zergling", "zerg_hydralisk", "zerg_ultralisk", "zerg_larva", "zerg_egg"] }, "owner": { "type": "integer", "minimum": 0, "maximum": 15 }, "phase": { "enum": ["complete", "incomplete"] }, "generation": { "type": "integer", "minimum": 1 }, "session": { "type": "string" } }, "additionalProperties": false },
    "actorBinding": { "type": "object", "required": ["id", "session", "generation", "participant", "native_id", "creation_frame"], "properties": { "id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "session": { "type": "string" }, "generation": { "type": "integer", "minimum": 1 }, "participant": { "enum": ["publisher", "controller"] }, "native_id": { "type": "string", "pattern": "^[0-9]+$" }, "creation_frame": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "actorMorph": {"type": "object", "required": ["id", "session", "generation", "from_type", "type", "phase"], "properties": {"id": {"type": "string", "pattern": "^openbw:[0-9]+$"}, "session": {"type": "string"}, "generation": {"type": "integer", "minimum": 1}, "from_type": {"type": "string"}, "type": {"type": "string"}, "phase": {"enum": ["complete", "incomplete"]}}, "additionalProperties": false},
    "actorDespawn": { "type": "object", "required": ["id", "session", "generation"], "properties": { "id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "session": { "type": "string" }, "generation": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "spawnRequestID": { "type": "string", "pattern": "^[a-zA-Z0-9_.:/#-]{1,128}$" },
    "spawnRequest": { "type": "object", "required": ["request_id", "unit_type", "count", "x", "y", "formation", "player_id"], "properties": { "request_id": { "$ref": "#/$defs/spawnRequestID" }, "unit_type": { "enum": ["terran_marine", "zerg_zergling", "zerg_hydralisk", "zerg_ultralisk"] }, "count": { "type": "integer", "minimum": 1, "maximum": 5 }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }, "formation": { "const": "compact" }, "player_id": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "spawnExecute": { "type": "object", "required": ["request_id", "index", "unit_type", "x", "y"], "properties": { "request_id": { "$ref": "#/$defs/spawnRequestID" }, "index": { "type": "integer", "minimum": 0, "maximum": 4 }, "unit_type": { "enum": ["terran_marine", "zerg_zergling", "zerg_hydralisk", "zerg_ultralisk"] }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "spawnUnitResult": { "type": "object", "required": ["index", "state"], "properties": { "index": { "type": "integer", "minimum": 0, "maximum": 4 }, "state": { "enum": ["queued", "issued", "created", "ready", "rejected", "failed", "uncertain"] }, "actor_id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "x": { "type": "integer" }, "y": { "type": "integer" }, "reason": { "type": "string" } }, "additionalProperties": false },
    "spawnStatus": { "type": "object", "required": ["request_id", "state", "units"], "properties": { "request_id": { "$ref": "#/$defs/spawnRequestID" }, "state": { "enum": ["queued", "issued", "created", "ready", "rejected", "failed", "uncertain"] }, "reason": { "type": "string" }, "units": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/spawnUnitResult" } } }, "additionalProperties": false },
    "nativeSpawnStatus": { "type": "object", "required": ["request_id", "index", "state"], "properties": { "request_id": { "$ref": "#/$defs/spawnRequestID" }, "index": { "type": "integer", "minimum": 0, "maximum": 4 }, "state": { "enum": ["created", "failed", "uncertain", "not_received"] }, "actor_id": { "type": "string", "pattern": "^openbw:[0-9]+$" }, "x": { "type": "integer" }, "y": { "type": "integer" }, "reason": { "type": "string" } }, "additionalProperties": false },
    "point": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }, "additionalProperties": false },
    "rect": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "entity": {
      "type": "object",
      "required": ["id", "source", "source_id", "kind", "type", "owner", "position", "elevation", "geometry", "collision", "destructible", "combat", "revision"],
      "properties": {
        "id": { "type": "string" }, "source": { "enum": ["openrct2", "openbw"] },
        "source_id": { "type": "string" }, "kind": { "type": "string" }, "type": { "type": "string" },
        "owner": { "type": "integer" }, "position": { "$ref": "#/$defs/point" }, "rotation": { "type": "integer", "minimum": 0, "maximum": 255 }, "elevation": { "type": "integer" },
        "geometry": { "type": "object", "properties": { "cells": { "type": "array", "items": { "$ref": "#/$defs/point" } }, "rects": { "type": "array", "items": { "$ref": "#/$defs/rect" } } } },
        "collision": { "type": "object", "required": ["blocks"], "properties": { "blocks": { "type": "boolean" }, "mode": { "enum": ["legacy", "height_aware", "conservative"] }, "volumes": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/collisionVolume" } } } },
        "destructible": { "type": "boolean" },
        "combat": { "type": "object", "required": ["targetable", "health"], "properties": { "targetable": { "type": "boolean" }, "health": { "type": "integer", "minimum": 0 }, "armor": { "type": "integer", "minimum": 0 }, "damage_scale": { "type": "number", "minimum": 0, "maximum": 100 } } },
        "removal": { "type": "object", "properties": { "action": { "type": "string" }, "args": { "type": "object", "additionalProperties": { "type": "integer" } }, "effect": { "type": "string" } } },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "collisionVolume": { "type": "object", "required": ["rect", "base_z", "clearance_z", "occupied_quadrants", "classification"], "properties": { "rect": { "$ref": "#/$defs/rect" }, "base_z": { "type": "integer" }, "clearance_z": { "type": "integer" }, "occupied_quadrants": { "type": "integer", "minimum": 1, "maximum": 15 }, "classification": { "enum": ["physical", "approximate"] }, "source": { "type": "string", "maxLength": 128 } }, "additionalProperties": false },
    "pathLayer": { "type": "object", "required": ["base_height", "slope_direction", "clearance_height", "occupied_quadrants"], "properties": { "base_height": { "type": "integer" }, "slope_direction": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 }, "clearance_height": { "type": "integer" }, "occupied_quadrants": { "type": "integer", "minimum": 1, "maximum": 15 } }, "additionalProperties": false },
    "terrain": { "type": "object", "required": ["x", "y", "height", "water", "surface", "walkable"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "height": { "type": "integer" }, "slope": { "type": "integer", "minimum": 0, "maximum": 63 }, "water": { "type": "integer" }, "surface": { "type": "integer" }, "walkable": { "type": "boolean" }, "ground_paths": { "type": "array", "maxItems": 1, "items": { "type": "object", "required": ["base_height", "slope_direction"], "properties": { "base_height": { "type": "integer" }, "slope_direction": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 } }, "additionalProperties": false } }, "path_layers": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/pathLayer" } } }, "additionalProperties": false }
  }
}
