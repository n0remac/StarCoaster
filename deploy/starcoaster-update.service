[Unit]
Description=Update StarCoaster private game from origin/main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/Projects/rts-bridge
ExecStart=/bin/bash /home/pi/Projects/rts-bridge/scripts/update-pi-game.sh
TimeoutStartSec=infinity
StandardOutput=append:/media/pi/media1/rts-bridge/build/pi-update-service.log
StandardError=append:/media/pi/media1/rts-bridge/build/pi-update-service.log
